<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Ticket Triage Load Test" enabled="true">
      <stringProp name="TestPlan.comments">Open-loop workload: requests ARRIVE at a fixed rate (Open Model Thread Group, Poisson arrivals) whether or not earlier requests have finished, so a slow server builds a backlog instead of slowing the load. POST /tickets runs at TR-1 (1,312 tickets/hour) off-peak and TR-2 (3,936 tickets/hour) at peak, in an off-peak / peak / off-peak sequence; GET /search runs at search_k x the ticket rate. Rates are real per-hour rates (no time compression). RESPONSE_TIMEOUT_MS is 630000 = the service's 600 s limit on its Ollama call + 30 s, so JMeter sees every answer the service itself gives (200, or 502 when that limit fires). It is not a bound on total server time: that 600 s starts only once a request gets one of the service's 40 threads, so a request that queued for a thread can run past 630 s. JMeter then records a timeout error while the service still finishes and stores the ticket; analysis/reconcile.py pairs these by start time. The cap keeps an overloaded run from draining for hours. Every schedule ends with pause(DRAIN_SEC), DRAIN_SEC = connect + response timeout = 635 s, because JMeter interrupts a group's in-flight requests the moment its schedule ends; a run therefore lasts the three phases plus 635 s. Pass -Jrun_id=&lt;id&gt;; each run writes its own results/&lt;run_id&gt;-&lt;timestamp&gt;.jtl.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,8000)}</stringProp>
          </elementProp>
          <elementProp name="RUN_ID" elementType="Argument">
            <stringProp name="Argument.name">RUN_ID</stringProp>
            <stringProp name="Argument.value">${__P(run_id,norun)}</stringProp>
          </elementProp>
          <elementProp name="DATA_FILE" elementType="Argument">
            <stringProp name="Argument.name">DATA_FILE</stringProp>
            <stringProp name="Argument.value">${__P(data_file,data/tickets.jsonl)}</stringProp>
          </elementProp>
          <elementProp name="SEARCH_FILE" elementType="Argument">
            <stringProp name="Argument.name">SEARCH_FILE</stringProp>
            <stringProp name="Argument.value">${__P(search_file,data/search_terms.csv)}</stringProp>
          </elementProp>
          <elementProp name="TICKETS_PER_HOUR_TR1" elementType="Argument">
            <stringProp name="Argument.name">TICKETS_PER_HOUR_TR1</stringProp>
            <stringProp name="Argument.value">${__P(tickets_per_hour_tr1,1312)}</stringProp>
          </elementProp>
          <elementProp name="TICKETS_PER_HOUR_TR2" elementType="Argument">
            <stringProp name="Argument.name">TICKETS_PER_HOUR_TR2</stringProp>
            <stringProp name="Argument.value">${__P(tickets_per_hour_tr2,3936)}</stringProp>
          </elementProp>
          <elementProp name="SEARCH_K" elementType="Argument">
            <stringProp name="Argument.name">SEARCH_K</stringProp>
            <stringProp name="Argument.value">${__P(search_k,2)}</stringProp>
          </elementProp>
          <elementProp name="OFFPEAK_DURATION_SEC" elementType="Argument">
            <stringProp name="Argument.name">OFFPEAK_DURATION_SEC</stringProp>
            <stringProp name="Argument.value">${__P(offpeak_duration_sec,120)}</stringProp>
          </elementProp>
          <elementProp name="PEAK_DURATION_SEC" elementType="Argument">
            <stringProp name="Argument.name">PEAK_DURATION_SEC</stringProp>
            <stringProp name="Argument.value">${__P(peak_duration_sec,180)}</stringProp>
          </elementProp>
          <elementProp name="CONNECT_TIMEOUT_MS" elementType="Argument">
            <stringProp name="Argument.name">CONNECT_TIMEOUT_MS</stringProp>
            <stringProp name="Argument.value">${__P(connect_timeout_ms,5000)}</stringProp>
          </elementProp>
          <elementProp name="RESPONSE_TIMEOUT_MS" elementType="Argument">
            <stringProp name="Argument.name">RESPONSE_TIMEOUT_MS</stringProp>
            <stringProp name="Argument.value">${__P(response_timeout_ms,630000)}</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <!-- Values computed from the Test Plan variables. They must live in this separate element: JMeter evaluates the
           Test Plan's own variables before any variable exists (vars is null there, so the scripts would return empty),
           and evaluates this element afterwards. -->
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Derived Values" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="OFFPEAK2_DELAY_SEC" elementType="Argument">
            <stringProp name="Argument.name">OFFPEAK2_DELAY_SEC</stringProp>
            <stringProp name="Argument.value">${__groovy(Integer.parseInt(vars.get("OFFPEAK_DURATION_SEC")) + Integer.parseInt(vars.get("PEAK_DURATION_SEC")),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SEARCH_PER_HOUR_TR1" elementType="Argument">
            <stringProp name="Argument.name">SEARCH_PER_HOUR_TR1</stringProp>
            <stringProp name="Argument.value">${__groovy(Double.parseDouble(vars.get("TICKETS_PER_HOUR_TR1")) * Double.parseDouble(vars.get("SEARCH_K")),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SEARCH_PER_HOUR_TR2" elementType="Argument">
            <stringProp name="Argument.name">SEARCH_PER_HOUR_TR2</stringProp>
            <stringProp name="Argument.value">${__groovy(Double.parseDouble(vars.get("TICKETS_PER_HOUR_TR2")) * Double.parseDouble(vars.get("SEARCH_K")),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <!-- Every schedule ends with pause(DRAIN_SEC): when a schedule ends, JMeter interrupts requests still in
               flight, so each group waits long enough for its last request to finish or hit its own timeout. -->
          <elementProp name="DRAIN_SEC" elementType="Argument">
            <stringProp name="Argument.name">DRAIN_SEC</stringProp>
            <stringProp name="Argument.value">${__groovy((int) Math.ceil((Long.parseLong(vars.get("CONNECT_TIMEOUT_MS")) + Long.parseLong(vars.get("RESPONSE_TIMEOUT_MS"))) / 1000.0d),)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>

      <!-- X-Run-Id tags each server log line with the run; applies to every sampler below -->
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="X-Run-Id Header" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">X-Run-Id</stringProp>
            <stringProp name="Header.value">${RUN_ID}</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Capture X-Request-ID" enabled="true">
        <stringProp name="RegexExtractor.useHeaders">true</stringProp>
        <stringProp name="RegexExtractor.refname">req_id</stringProp>
        <stringProp name="RegexExtractor.regex">(?i)x-request-id:\s*(\w+)</stringProp>
        <stringProp name="RegexExtractor.template">$1$</stringProp>
        <stringProp name="RegexExtractor.default"></stringProp>
        <boolProp name="RegexExtractor.default_empty_value">true</boolProp>
        <stringProp name="RegexExtractor.match_number">1</stringProp>
      </RegexExtractor>
      <hashTree/>

      <!-- ===================== TICKET INTAKE: POST /tickets ===================== -->

      <OpenModelThreadGroup guiclass="OpenModelThreadGroupGui" testclass="OpenModelThreadGroup" testname="Tickets - Off-Peak (AM)" enabled="true">
        <elementProp name="ThreadGroup.main_controller" elementType="OpenModelThreadGroupController" guiclass="OpenModelThreadGroupControllerGui" testclass="OpenModelThreadGroupController" testname="Open Model Controller" enabled="true"/>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <stringProp name="OpenModelThreadGroup.schedule">rate(${TICKETS_PER_HOUR_TR1}/hour) random_arrivals(${OFFPEAK_DURATION_SEC} sec) rate(${TICKETS_PER_HOUR_TR1}/hour) pause(${DRAIN_SEC} sec)</stringProp>
        <stringProp name="OpenModelThreadGroup.random_seed"></stringProp>
      </OpenModelThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Ticket Data" enabled="true">
          <stringProp name="filename">${DATA_FILE}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">jsonBody</stringProp>
          <boolProp name="ignoreFirstLine">false</boolProp>
          <stringProp name="delimiter">&#9;</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type Header" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /tickets" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${jsonBody}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">${PROTOCOL}</stringProp>
          <stringProp name="HTTPSampler.path">/tickets</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.connect_timeout">${CONNECT_TIMEOUT_MS}</stringProp>
          <stringProp name="HTTPSampler.response_timeout">${RESPONSE_TIMEOUT_MS}</stringProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>

